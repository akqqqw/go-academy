# Скопируйте в .env и заполните значениями проекта Supabase.
# Этот файл не содержит секретов и коммитится в репозиторий.

# Project Settings → API → publishable key (или legacy anon key)
PUBLIC_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Project Settings → Database → Connect → Session pooler
# Пароль можно задать заново через Reset database password.
CONNECTION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Необязательно: адрес проекта. По умолчанию выводится из postgres.<project-ref>.
# SUPABASE_URL=https://<project-ref>.supabase.co

# 0 отключает проверку токенов (только для локальной отладки на SQLite).
# GOACADEMY_REQUIRE_AUTH=1
