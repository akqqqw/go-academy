# Публичные параметры Supabase для мобильного приложения.
# EXPO_PUBLIC_* встраиваются в бандл — это тот же publishable/anon ключ,
# который уже отдаётся браузеру. Секреты (service_role, строка БД) сюда не кладут.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Адрес Go-API. Для эмулятора Android локальный сервер доступен как 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=https://go-academy-one.vercel.app

# Необязательно: заполняется `eas init`.
EAS_PROJECT_ID=
